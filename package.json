{
  "name": "warrantywise",
  "version": "1.0.0",
  "description": "WarrantyWise — Personal Warranty & Repair Tracker",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node backend/server.js",
    "test": "node backend/tests/api.test.js",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "azure:init-db": "node backend/scripts/initAzureSql.js",
    "azure:migrate": "node backend/scripts/migrateLocalToAzure.js",
    "azure:test-db": "node backend/scripts/testAzureSql.js",
    "azure:test-blob": "node backend/scripts/testAzureBlob.js",
    "postinstall": "node -e \"const fs=require('fs'),cp=require('child_process'); cp.execSync('npm install --prefix backend',{stdio:'inherit'}); if(!fs.existsSync('frontend/dist')){ cp.execSync('npm install --prefix frontend && npm run build --prefix frontend',{stdio:'inherit'}); }\""
  },
  "keywords": [
    "warranty",
    "repair-tracker",
    "azure-sql",
    "azure-blob-storage",
    "react",
    "express"
  ],
  "author": "WarrantyWise Engineering",
  "license": "MIT"
}

