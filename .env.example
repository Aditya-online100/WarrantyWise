# ============================================================================
# WarrantyWise — Environment Configuration (.env.example)
# Copy this file to .env and replace placeholder values for local development.
# NEVER commit your actual .env file or secrets to source control.
# ============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# JWT Authentication Secret
# Replace with a long, randomly generated secret in your local .env and Azure App Service
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ============================================================================
# AZURE SQL DATABASE CONFIGURATION
# If DB_SERVER is left blank, WarrantyWise runs in Local SQLite fallback mode.
# When deploying to Azure App Service with Managed Identity:
#   DB_SERVER=<your-sql-server>.database.windows.net
#   DB_NAME=WarrantyWiseDB
#   DB_AUTH_MODE=managed_identity
# Do not set DB_USER or DB_PASSWORD when using Managed Identity.
# ============================================================================
DB_SERVER=
DB_NAME=WarrantyWiseDB
DB_AUTH_MODE=managed_identity
DB_USER=
DB_PASSWORD=
DB_PORT=1433
# Optional: set only when using a User-Assigned Managed Identity
# AZURE_CLIENT_ID=<your-managed-identity-client-id>

# ============================================================================
# AZURE BLOB STORAGE CONFIGURATION
# If AZURE_STORAGE_ACCOUNT_NAME is left blank, WarrantyWise stores files on local disk.
# Uses @azure/identity DefaultAzureCredential (never store storage account keys).
# When deploying to Azure App Service:
#   AZURE_STORAGE_ACCOUNT_NAME=<your-storage-account>
#   AZURE_STORAGE_CONTAINER_NAME=warranty-documents
# ============================================================================
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=warranty-documents

